{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Issuer": "apexauto-api",
    "Audience": "apexauto-clients",
    "ExpiryMinutes": 120
  },
  "RateLimiting": {
    "ApiRequestsPerWindow": 300,
    "BearerRequestsPerWindow": 600,
    "UserReadBurst": 120,
    "UserReadTokensPerSecond": 5,
    "UserWritesPerWindow": 60,
    "PictureReadsPerWindow": 300,
    "LoginAttemptsPerWindow": 5,
    "VerificationAttemptsPerWindow": 10,
    "PhotoTransferConcurrency": 4,
    "PhotoReadConcurrency": 8,
    "PhotoReadQueueLimit": 96,
    "PhotoReadQueueSeconds": 10,
    "PictureDownloadConcurrency": 8,
    "PictureDownloadQueueLimit": 48,
    "PictureDownloadQueueSeconds": 2,
    "WindowSeconds": 60
  },
  "IntakePhotos": {
    "UnsubmittedLifetimeHours": 24,
    "CancelledRetentionDays": 30,
    "CleanupEnabled": true
  },
  "InspectionSchedule": {
    "OpensAt": "09:00:00",
    "ClosesAt": "18:00:00",
    "SlotMinutes": 90,
    "HorizonDays": 30,
    "NoticeMinutes": 120,
    "OpenDays": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday"
    ]
  }
}
