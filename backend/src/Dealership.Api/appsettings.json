{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Issuer": "apexauto-api",
    "Audience": "apexauto-clients",
    "ExpiryMinutes": 120
  },
  "IntakePhotos": {
    "UnsubmittedLifetimeHours": 24,
    "CancelledRetentionDays": 30,
    "CleanupEnabled": true
  },
  "InspectionSchedule": {
    "OpensAt": "09:00:00",
    "ClosesAt": "18:00:00",
    "SlotMinutes": 90,
    "HorizonDays": 30,
    "NoticeMinutes": 120,
    "OpenDays": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
  }
}
