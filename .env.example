# Environment & Seeding Gate
ASPNETCORE_ENVIRONMENT=Development
SEED_DEMO_DATA=true

# PostgreSQL Database
POSTGRES_DB=apexauto_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpassword
POSTGRES_PORT=5432

# Connection Strings
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=apexauto_dev;Username=postgres;Password=secretpassword

# JWT Security Settings
JwtSettings__Secret=ApexAutoSuperSecretKeyForJwtAuthentication2026!#SecureToken12345
JwtSettings__Issuer=apexauto-api
JwtSettings__Audience=apexauto-clients
JwtSettings__ExpiryMinutes=120

# S3-Compatible Object Storage (Local Adobe S3Mock :9090, Cloudflare R2 / AWS S3 in prod)
AWS__ServiceURL=http://localhost:9090
AWS__AccessKey=test
AWS__SecretKey=test
AWS__BucketName=apexauto-media
AWS__ForcePathStyle=true

# Application URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:5114
NEXT_PUBLIC_API_BASE_URL=http://localhost:5114

# Payment Gateway (Phase 1: Simulated / Phase 2: Billplz Sandbox)
Billplz__Enabled=false
Billplz__ApiKey=your_billplz_api_key_here
Billplz__XSignatureKey=your_billplz_x_signature_key_here
Billplz__CollectionId=your_billplz_collection_id_here
Billplz__BaseUrl=https://www.billplz-sandbox.com/api/v3/

# Outbound Email Service (Transactional confirmation mailer)
Email__SenderEmail=your_email@gmail.com
Email__SenderDisplayName=ApexAuto
Email__AppPassword=your_app_password_here
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__EnableSsl=true
