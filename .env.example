# Environment (Development reads this file; deployed hosts must inject real variables)
ASPNETCORE_ENVIRONMENT=Development
# API startup does not seed data. Use the deliberate guarded Development fixture command.
# See docs/runbooks/verification.md, Development fixture commands, for prerequisites and seed/review/clear.

# PostgreSQL Database (required by docker-compose; no defaults)
POSTGRES_DB=apexauto_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Connection Strings (password must match POSTGRES_PASSWORD)
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=apexauto_dev;Username=postgres;Password=CHANGE_ME

# JWT Secret (required, at least 32 characters). Generate: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
# Defaults live in appsettings.json. Uncomment to override:
# JwtSettings__Issuer=apexauto-api
# JwtSettings__Audience=apexauto-clients
# JwtSettings__ExpiryMinutes=120
JwtSettings__Secret=

# S3-Compatible Object Storage (Local Adobe S3Mock :9090, Cloudflare R2 / AWS S3 in prod)
AWS__ServiceURL=http://127.0.0.1:9090
AWS__AccessKey=CHANGE_ME
AWS__SecretKey=CHANGE_ME
AWS__BucketName=apexauto-media
AWS__Region=auto
AWS__ForcePathStyle=true
AWS__AllowInsecureHttp=false
S3_PORT=9090

# Application URLs and hosts
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:5114
ASPNETCORE_URLS=http://localhost:5114
# Semicolon-separated Host header allow-list. Wildcards and comma separators are rejected.
AllowedHosts=localhost
# Forwarding is disabled unless exact trusted proxy IPs are configured.
# The proxy must sanitize forwarded headers; never expose a trusted proxy address to callers.
# ForwardedHeaders__KnownProxies__0=10.0.0.10
# Optional: alternate Next.js build directory
# NEXT_DIST_DIR=.next

# Billplz hosted deposit payment. Enabled=false keeps the simulated deposit; true sends staff deposit links to Billplz and
# requires every value below. PublicBaseUrl is the address Billplz can reach this API on (a tunnel while it runs locally).
Billplz__Enabled=false
Billplz__ApiKey=
Billplz__XSignatureKey=
Billplz__CollectionId=
Billplz__BaseUrl=https://www.billplz-sandbox.com/api/v3/
Billplz__PublicBaseUrl=

# Outbound Email Service. Delivery is opt-in; run the local inbox with docker compose --profile mail up -d mailpit.
# For the local inbox, set Email__Mode=Loopback in .env and restart the backend; Disabled queues mail without delivery.
# Loopback mode requires Development, local APP_BASE_URL and localhost SMTP; captured mail appears at http://localhost:8025.
Email__Mode=Disabled
Email__SenderEmail=no-reply@apexauto.invalid
Email__SenderDisplayName=ApexAuto
Email__Username=
Email__AppPassword=
Email__SmtpHost=127.0.0.1
Email__SmtpPort=1025
Email__EnableSsl=false
